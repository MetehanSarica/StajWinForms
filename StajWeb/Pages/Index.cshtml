@page
@model IndexModel
@{
    ViewData["Title"] = "Bilet Ara";

}

<div class="text-center py-5">
    <h1 class="mb-4">Otobüs Bileti Ara</h1>
    <div class="card shadow mx-auto" style="max-width:500px;">
        <div class="card-body p-4">
            <form method="get" action="/Seferler">
                <div class="mb-3">
                    <select name="kalkisId" asp-items="Model.SehirListesi"
                            class="form-select">
                        <option value="">Kalkış Yeri</option>
                    </select>
                </div>
                <div class="mb-3">
                    <select name="varisId" asp-items="Model.SehirListesi"
                            class="form-select">
                        <option value="">Varış Yeri</option>
                    </select>
                </div>
                <div class="mb-3">
                    <input type="date" name="tarih" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Sefer Ara</button>
            </form>
            <a href="/Seferler" class="btn btn-outline-secondary w-100 mt-2">Tüm Seferleri Göster</a>
        </div>
    </div>
</div>