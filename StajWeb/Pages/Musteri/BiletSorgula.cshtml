@page
@model StajWeb.Pages.BiletSorgulaModel
@{
    ViewData["Title"] = "Bilet Sorgula";
}

<h4 class="mb-4">Bilet Sorgula</h4>

<div class="card shadow-sm mb-4" style="max-width:400px;">
    <div class="card-body">
        <form method="post">
            <div class="input-group">
                <input asp-for="MusteriTc" class="form-control" placeholder="TC Kimlik No" maxlength="11" />
                <button type="submit" class="btn btn-primary">Sorgula</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Biletler.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Bilet No</th>
                    <th>Firma</th>
                    <th>Kalkış</th>
                    <th>Varış</th>
                    <th>Tarih</th>
                    <th>Koltuk</th>
                    <th>Fiyat</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Biletler)
                {
                    <tr>
                        <td>@b.BiletId</td>
                        <td>@b.FirmaAdi</td>
                        <td>@b.KalkisSehirAdi</td>
                        <td>@b.VarisSehirAdi</td>
                        <td>@b.KalkisZamani.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@b.KoltukNo</td>
                        <td>@b.Fiyat ₺</td>
                        <td><a href="/Musteri/BiletIptal?biletId=@b.BiletId" class="btn btn-danger btn-sm">İptal</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
