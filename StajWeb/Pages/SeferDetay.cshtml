@page "{id:int}"
@model StajWeb.Pages.SeferDetayModel
@{
    ViewData["Title"] = "Sefer Detayları";
    var toplamKoltuk = 36;
    var alinmisKoltuklar = Model.Biletler.ToDictionary(b => b.KoltukNo, b => b.Cinsiyet);
}

<div class="card shadow-sm mb-4" style="max-width:500px;">
    <div class="card-body">
        <h4 class="card-title mb-1">@Model.Sefer.FirmaAdi</h4>
        <p class="mb-1 fs-5">@Model.Sefer.KalkisSehirAdi → @Model.Sefer.VarisSehirAdi</p>
        <p class="text-muted mb-0">
            @Model.Sefer.KalkisZamani.ToString("dd/MM/yyyy HH:mm")
            &nbsp;|&nbsp;
            <span class="text-primary fw-bold">@Model.Sefer.Fiyat ₺</span>
        </p>
    </div>
</div>

<script>

    const secilenKoltuklar = [];

    function devamEt() {
        if (secilenKoltuklar.length === 0) {
            alert("Lütfen en az bir koltuk seçin.");
            return;
        }

        window.location = '/Satinal?seferId=@Model.Id&koltuklar=' + secilenKoltuklar.join(',');
    }

    function koltukSec(btn, koltukNo) {

        const idx = secilenKoltuklar.indexOf(koltukNo);
        if (idx == -1) {
            secilenKoltuklar.push(koltukNo);
            btn.style.background = '#ffc107';
        } else {
            secilenKoltuklar.splice(idx, 1);
            btn.style.background = '#28a745';
        }
    }

</script>

<style>
    .bus-h { display: flex; flex-direction: row; border: 3px solid #666; border-radius: 20px; padding: 12px; background: #f5f5f5; width: fit-content; }
    .driver-col { display: flex; flex-direction: column; align-items: center; justify-content: space-between; margin-right: 12px; border-right: 2px dashed #aaa; padding-right: 12px; gap: 6px; }
    .driver-seat { width: 42px; height: 42px; background: #ffc107; border-radius: 6px; }
    .steering-wheel { width: 36px; height: 36px; border: 4px solid #555; border-radius: 50%; background: #ccc; }
    .seats-area { display: flex; flex-direction: column; gap: 0; }
    .seat-row { display: flex; flex-direction: row; gap: 4px; margin: 2px 0; }
    .aisle-h { height: 16px; }
    .seat { width: 42px; height: 42px; border-radius: 6px; font-weight: bold; font-size: 12px; border: none; cursor: pointer; }
    .seat.available { background: #28a745; color: white; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
    .seat.available:hover { background: #218838; color: white; }
    .seat.male { background: #007bff; color: white; cursor: not-allowed; }
    .seat.female { background: #e83e8c; color: white; cursor: not-allowed; }
</style>

@{
    int numCols = 9;
}

<div class="bus-h">
    <div class="driver-col">
        <div class="driver-seat"></div>
        <div class="steering-wheel"></div>
        <div class="driver-seat"></div>
    </div>
    <div class="seats-area">
        @for (int r = 0; r < 2; r++)
        {
            <div class="seat-row">
                @for (int c = 0; c < numCols; c++)
                {
                    int koltukNo = c * 4 + r + 1;
                    if (koltukNo <= toplamKoltuk)
                    {
                        var cinsiyet = alinmisKoltuklar.ContainsKey(koltukNo) ? alinmisKoltuklar[koltukNo] : null;
                        if (cinsiyet == "E") { <button class="seat male" disabled>@koltukNo</button> }
                        else if (cinsiyet == "K") { <button class="seat female" disabled>@koltukNo</button> }
                        else { <button class="seat available" onclick="koltukSec(this, @koltukNo)">@koltukNo</button> }
                    }
                }
            </div>
        }
        <div class="aisle-h"></div>
        @for (int r = 2; r < 4; r++)
        {
            <div class="seat-row">
                @for (int c = 0; c < numCols; c++)
                {
                    int koltukNo = c * 4 + r + 1;
                    if (koltukNo <= toplamKoltuk)
                    {
                        var cinsiyet = alinmisKoltuklar.ContainsKey(koltukNo) ? alinmisKoltuklar[koltukNo] : null;
                        if (cinsiyet == "E") { <button class="seat male" disabled>@koltukNo</button> }
                        else if (cinsiyet == "K") { <button class="seat female" disabled>@koltukNo</button> }
                        else
                        { <button class="seat available" onclick="koltukSec(this, @koltukNo)">@koltukNo</button> }
                    }
                }
            </div>
        }
    </div>
</div>

<div class="d-flex gap-3 mt-3 align-items-center">
    <span><span style="display:inline-block;width:16px;height:16px;background:#28a745;border-radius:3px;"></span> Boş</span>
    <span><span style="display:inline-block;width:16px;height:16px;background:#007bff;border-radius:3px;"></span> Erkek</span>
    <span><span style="display:inline-block;width:16px;height:16px;background:#e83e8c;border-radius:3px;"></span> Kadın</span>
    <span><span style="display:inline-block;width:16px;height:16px;background:#ffc107;border-radius:3px;"></span> Seçili</span>
</div>

<div class="mt-3">
    <button onclick="devamEt()" class="btn btn-primary px-4">Devam Et</button>
</div>