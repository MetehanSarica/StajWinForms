@page
@model StajWeb.Pages.Admin.SeferOtobusEslemeModel
@{
    ViewData["Title"] = "Sefer–Otobüs Eşleme";
    var y = Model.Yetki;
}

<h4>Sefer–Otobüs Eşleme</h4>
<a href="/Admin" class="btn btn-secondary btn-sm mb-3">← Panele Dön</a>

<table id="tblSeferler" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Güzergah</th>
            <th>Kalkış</th>
            <th>Mevcut Otobüs</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model.Seferler)
    {
        <tr>
            <td>@s.SeferId</td>
            <td>@s.KalkisSehirAdi → @s.VarisSehirAdi</td>
            <td>@s.KalkisZamani.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@(s.OtobusPlaka ?? "—")</td>
            <td>
                @if (y?.Ata == true)
                {
                    <form method="post" asp-page-handler="Ata" style="display:inline">
                        <input type="hidden" name="seferId" value="@s.SeferId" />
                        <select name="otobusId" class="form-select form-select-sm d-inline-block w-auto">
                            @foreach (var o in Model.Otobusler)
                            {
                                if (o.OtobusId == s.OtobusId)
                                { <option value="@o.OtobusId" selected>@o.Plaka</option> }
                                else
                                { <option value="@o.OtobusId">@o.Plaka</option> }
                            }
                        </select>
                        <button type="submit" class="btn btn-success btn-sm">Ata</button>
                    </form>
                }
                @if (y?.Kaldir == true && s.OtobusId != null)
                {
                    <form method="post" asp-page-handler="Kaldir" style="display:inline"
                          onsubmit="return confirm('Otobüs ataması kaldırılsın mı?')">
                        <input type="hidden" name="seferId" value="@s.SeferId" />
                        <button type="submit" class="btn btn-danger btn-sm">Kaldır</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(function () {
        $('#tblSeferler').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json' } });
    });
</script>
}
