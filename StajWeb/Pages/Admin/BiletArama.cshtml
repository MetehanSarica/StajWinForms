@page
@model StajWeb.Pages.Admin.BiletAramaModel
@{
    ViewData["Title"] = "Bilet Arama";
}

<h4>Bilet Arama</h4>
<a href="/Admin" class="btn btn-secondary btn-sm mb-3">← Panele Dön</a>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">Kalkış Şehri</label>
        <select name="KalkisId" class="form-select form-select-sm">
            <option value="0">— Tümü —</option>
            @foreach (var s in Model.Sehirler)
            {
                <option value="@s.SehirId" selected="@(Model.KalkisId == s.SehirId)">@s.SehirAdi</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Varış Şehri</label>
        <select name="VarisId" class="form-select form-select-sm">
            <option value="0">— Tümü —</option>
            @foreach (var s in Model.Sehirler)
            {
                <option value="@s.SehirId" selected="@(Model.VarisId == s.SehirId)">@s.SehirAdi</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Tarih</label>
        <input type="date" name="Tarih" class="form-control form-control-sm" value="@Model.Tarih" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary btn-sm w-100">Ara</button>
    </div>
</form>

@if (Model.Biletler.Count == 0)
{
    <div class="text-muted">Sonuç bulunamadı.</div>
}
else
{
    <table id="tblBiletler" class="table table-striped table-bordered table-sm">
        <thead>
            <tr>
                <th>Bilet ID</th>
                <th>Ad Soyad</th>
                <th>TC</th>
                <th>Koltuk</th>
                <th>Kalkış</th>
                <th>Varış</th>
                <th>Tarih</th>
                <th>Firma</th>
                <th>Fiyat</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Biletler)
            {
                <tr>
                    <td>@b.BiletId</td>
                    <td>@b.MusteriAdSoyad</td>
                    <td>@b.MusteriTc</td>
                    <td>@b.KoltukNo</td>
                    <td>@b.KalkisSehirAdi</td>
                    <td>@b.VarisSehirAdi</td>
                    <td>@b.KalkisZamani.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@b.FirmaAdi</td>
                    <td>₺@b.Fiyat.ToString("N2")</td>
                    <td><a href="?handler=Pdf&biletId=@b.BiletId" class="btn btn-sm btn-outline-primary" target="_blank">Yazdır</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            @if (Model.Biletler.Count > 0)
            {
                <text>$('#tblBiletler').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json' }, order: [[0, 'desc']] });</text>
            }
        });
    </script>
}
