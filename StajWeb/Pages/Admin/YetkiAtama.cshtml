@page
@model StajWeb.Pages.Admin.YetkiAtamaModel
@using StajWeb.Dtos
@{
    ViewData["Title"] = "Yetki Atama";
    var y = Model.Yetki;

    KullaniciYetkiDto GetYetki(string formAdi) =>
        Model.Yetkiler.FirstOrDefault(x => x.FormAdi == formAdi) ?? new();

    bool Destekler(string formAdi, string yetki) =>
        YetkiAtamaModel.FormYetkileri.TryGetValue(formAdi, out var f) && f.Yetkiler.Contains(yetki);
}

<h4>Yetki Atama</h4>
<a href="/Admin" class="btn btn-secondary btn-sm mb-3">← Panele Dön</a>

<div class="mb-3">
    <label class="form-label fw-bold">Kullanıcı Seç</label>
    <select class="form-select w-auto" onchange="location='?kullaniciId='+this.value">
        <option value="">-- Seçiniz --</option>
        @foreach (var k in Model.Kullanicilar)
        {
            if (k.KullaniciId == Model.SeciliKullanici?.KullaniciId)
            { <option value="@k.KullaniciId" selected>@k.KullaniciAdi (@(k.AdSoyad ?? "—"))</option> }
            else
            { <option value="@k.KullaniciId">@k.KullaniciAdi (@(k.AdSoyad ?? "—"))</option> }
        }
    </select>
</div>

@if (Model.SeciliKullanici != null)
{
    <form method="post" asp-page-handler="Kaydet">
        <input type="hidden" name="kullaniciId" value="@Model.SeciliKullanici.KullaniciId" />

        <table class="table table-bordered table-sm">
            <thead class="table-dark">
                <tr>
                    <th>Form</th>
                    <th class="text-center">Ekle</th>
                    <th class="text-center">Sil</th>
                    <th class="text-center">Değiştir</th>
                    <th class="text-center">İncele</th>
                    <th class="text-center">Ata</th>
                    <th class="text-center">Kaldır</th>
                    <th class="text-center">Kaydet</th>
                    <th class="text-center">Aktif/Pasif</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var (formAdi, form) in YetkiAtamaModel.FormYetkileri)
            {
                var yetki = GetYetki(formAdi);
                <tr>
                    <td>@form.Baslik</td>
                    <td class="text-center">@if (Destekler(formAdi, "Ekle")) { <input type="checkbox" name="ekle_@formAdi" @(yetki.Ekle ? "checked" : "") /> } else { <input type="checkbox" disabled style="opacity:0.3" /> }</td>
                    <td class="text-center">@if (Destekler(formAdi, "Sil")) { <input type="checkbox" name="sil_@formAdi" @(yetki.Sil ? "checked" : "") /> } else { <input type="checkbox" disabled style="opacity:0.3" /> }</td>
                    <td class="text-center">@if (Destekler(formAdi, "Degistir")) { <input type="checkbox" name="degistir_@formAdi" @(yetki.Degistir ? "checked" : "") /> } else { <input type="checkbox" disabled style="opacity:0.3" /> }</td>
                    <td class="text-center">@if (Destekler(formAdi, "Incele")) { <input type="checkbox" name="incele_@formAdi" @(yetki.Incele ? "checked" : "") /> } else { <input type="checkbox" disabled style="opacity:0.3" /> }</td>
                    <td class="text-center">@if (Destekler(formAdi, "Ata")) { <input type="checkbox" name="ata_@formAdi" @(yetki.Ata ? "checked" : "") /> } else { <input type="checkbox" disabled style="opacity:0.3" /> }</td>
                    <td class="text-center">@if (Destekler(formAdi, "Kaldir")) { <input type="checkbox" name="kaldir_@formAdi" @(yetki.Kaldir ? "checked" : "") /> } else { <input type="checkbox" disabled style="opacity:0.3" /> }</td>
                    <td class="text-center">@if (Destekler(formAdi, "Kaydet")) { <input type="checkbox" name="kaydet_@formAdi" @(yetki.Kaydet ? "checked" : "") /> } else { <input type="checkbox" disabled style="opacity:0.3" /> }</td>
                    <td class="text-center">@if (Destekler(formAdi, "AktifPasif")) { <input type="checkbox" name="aktifpasif_@formAdi" @(yetki.AktifPasif ? "checked" : "") /> } else { <input type="checkbox" disabled style="opacity:0.3" /> }</td>
                </tr>
            }
            </tbody>
        </table>

        @if (y?.Kaydet == true)
        {
            <button type="submit" class="btn btn-primary">Kaydet</button>
        }
    </form>

    <div class="mt-2 d-flex gap-2">
        @if (y?.Kaydet == true)
        {
            <form method="post" asp-page-handler="Temizle"
                  onsubmit="return confirm('@Model.SeciliKullanici.KullaniciAdi kullanıcısının tüm yetkileri temizlensin mi?')">
                <input type="hidden" name="kullaniciId" value="@Model.SeciliKullanici.KullaniciId" />
                <button type="submit" class="btn btn-warning btn-sm">Tümünü Temizle</button>
            </form>
        }

        <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#kopyalaModal">
            Yetkileri Kopyala →
        </button>
    </div>

    <!-- Kopyala Modal -->
    <div class="modal fade" id="kopyalaModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yetkileri Kopyala — @Model.SeciliKullanici.KullaniciAdi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-page-handler="Kopyala">
                    <input type="hidden" name="kaynakId" value="@Model.SeciliKullanici.KullaniciId" />
                    <div class="modal-body">
                        <p class="text-muted small mb-2">Hedef kullanıcıları seçin:</p>
                        @foreach (var k in Model.Kullanicilar.Where(k => k.KullaniciId != Model.SeciliKullanici.KullaniciId))
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="hedefler" value="@k.KullaniciId" id="hdf_@k.KullaniciId" />
                                <label class="form-check-label" for="hdf_@k.KullaniciId">
                                    @k.KullaniciAdi (@(k.AdSoyad ?? "—"))
                                </label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary">Kopyala</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
