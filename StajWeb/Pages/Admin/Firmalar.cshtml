@page
@model StajWeb.Pages.Admin.FirmalarModel
@{
    ViewData["Title"] = "Firmalar";
    var y = Model.Yetki;
}

<h4>Firmalar</h4>
<a href="/Admin" class="btn btn-secondary btn-sm mb-3">← Panele Dön</a>

@if (y?.Ekle == true)
{
    <button class="btn btn-success btn-sm mb-3" data-bs-toggle="modal" data-bs-target="#ekleModal">+ Ekle</button>
}

<table id="tblFirmalar" class="table table-striped table-bordered">
    <thead><tr><th>ID</th><th>Firma Adı</th><th>İşlemler</th></tr></thead>
    <tbody>
        @foreach (var f in Model.Firmalar)
        {
            <tr>
                <td>@f.FirmaId</td>
                <td>@f.FirmaAdi</td>
                <td>
                    @if (y?.Degistir == true)
                    {
                        <button class="btn btn-warning btn-sm"
                                onclick="guncelleAc(@f.FirmaId, '@Html.Raw(f.FirmaAdi.Replace("'", "\\\'"))')">
                            Düzenle
                        </button>
                    }
                    @if (y?.Sil == true)
                    {
                        <form method="post" asp-page-handler="Sil" style="display:inline"
                              onsubmit="return confirm('@f.FirmaAdi silinsin mi?')">
                            <input type="hidden" name="firmaId" value="@f.FirmaId" />
                            <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Ekle Modal -->
@if (y?.Ekle == true)
{
    <div class="modal fade" id="ekleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Firma Ekle</h5></div>
                <form method="post" asp-page-handler="Ekle">
                    <div class="modal-body">
                        <input name="firmaAdi" class="form-control" placeholder="Firma Adı" required />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-success">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Güncelle Modal -->
@if (y?.Degistir == true)
{
    <div class="modal fade" id="guncelleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Firma Düzenle</h5></div>
                <form method="post" asp-page-handler="Guncelle">
                    <div class="modal-body">
                        <input type="hidden" name="firmaId" id="guncelleId" />
                        <input name="firmaAdi" id="guncelleAdi" class="form-control" required />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-warning">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () { $('#tblFirmalar').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json' } }); });
        function guncelleAc(id, adi) {
            document.getElementById('guncelleId').value = id;
            document.getElementById('guncelleAdi').value = adi;
            new bootstrap.Modal(document.getElementById('guncelleModal')).show();
        }
    </script>
}