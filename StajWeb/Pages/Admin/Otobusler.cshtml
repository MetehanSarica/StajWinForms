@page
@model StajWeb.Pages.Admin.OtobuslerModel
@{
    ViewData["Title"] = "Otobüsler";
    var y = Model.Yetki;
}

<h4>Otobüsler</h4>
<a href="/Admin" class="btn btn-secondary btn-sm mb-3">← Panele Dön</a>

@if (y?.Ekle == true)
{
    <button class="btn btn-success btn-sm mb-3" data-bs-toggle="modal" data-bs-target="#ekleModal">+ Ekle</button>
}

<table id="tblOtobusler" class="table table-striped table-bordered">
    <thead>
        <tr><th>ID</th><th>Plaka</th><th>Marka</th><th>Model</th><th>Koltuk</th><th>Firma</th><th>İşlemler</th></tr>
    </thead>
    <tbody>
    @foreach (var o in Model.Otobusler)
    {
        <tr>
            <td>@o.OtobusId</td>
            <td>@o.Plaka</td>
            <td>@o.Marka</td>
            <td>@o.Model</td>
            <td>@o.KoltukKapasitesi</td>
            <td>@(o.FirmaAdi ?? "—")</td>
            <td>
                @if (y?.Degistir == true)
                {
                    <button class="btn btn-warning btn-sm"
                            onclick="guncelleAc(@o.OtobusId,'@Html.Raw(o.Plaka)','@Html.Raw(o.Marka??"")',
                            '@Html.Raw(o.Model??"")',@o.KoltukKapasitesi,@(o.FirmaId?.ToString()??"0"))">
                        Düzenle
                    </button>
                }
                @if (y?.Sil == true)
                {
                    <form method="post" asp-page-handler="Sil" style="display:inline"
                          onsubmit="return confirm('@o.Plaka silinsin mi?')">
                        <input type="hidden" name="otobusId" value="@o.OtobusId" />
                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (y?.Ekle == true)
{
    <div class="modal fade" id="ekleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Otobüs Ekle</h5></div>
                <form method="post" asp-page-handler="Ekle">
                    <div class="modal-body">
                        <input name="plaka" class="form-control mb-2" placeholder="Plaka (7-9 karakter)"
                               required minlength="7" maxlength="9" />
                        <input name="marka" class="form-control mb-2" placeholder="Marka" required />
                        <input name="model" class="form-control mb-2" placeholder="Model" required />
                        <input name="koltukKapasitesi" type="number" class="form-control mb-2"
                               placeholder="Koltuk Kapasitesi" value="36" min="1" required />
                        <select name="firmaId" class="form-select">
                            <option value="0">(Firma Yok)</option>
                            @foreach (var f in Model.Firmalar)
                            {
                                <option value="@f.FirmaId">@f.FirmaAdi</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-success">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (y?.Degistir == true)
{
    <div class="modal fade" id="guncelleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Otobüs Düzenle</h5></div>
                <form method="post" asp-page-handler="Guncelle">
                    <div class="modal-body">
                        <input type="hidden" name="otobusId" id="gId" />
                        <input name="plaka" id="gPlaka" class="form-control mb-2" placeholder="Plaka"
                               required minlength="7" maxlength="9" />
                        <input name="marka" id="gMarka" class="form-control mb-2" placeholder="Marka" required />
                        <input name="model" id="gModel" class="form-control mb-2" placeholder="Model" required />
                        <input name="koltukKapasitesi" id="gKoltuk" type="number"
                               class="form-control mb-2" min="1" required />
                        <select name="firmaId" id="gFirma" class="form-select">
                            <option value="0">(Firma Yok)</option>
                            @foreach (var f in Model.Firmalar)
                            {
                                <option value="@f.FirmaId">@f.FirmaAdi</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-warning">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(function () {
        $('#tblOtobusler').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json' } });
    });
    function guncelleAc(id, plaka, marka, model, koltuk, firmaId) {
        document.getElementById('gId').value = id;
        document.getElementById('gPlaka').value = plaka;
        document.getElementById('gMarka').value = marka;
        document.getElementById('gModel').value = model;
        document.getElementById('gKoltuk').value = koltuk;
        document.getElementById('gFirma').value = firmaId;
        new bootstrap.Modal(document.getElementById('guncelleModal')).show();
    }
</script>
}
