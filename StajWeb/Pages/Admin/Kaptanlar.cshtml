@page
@model StajWeb.Pages.Admin.KaptanlarModel
@{
    ViewData["Title"] = "Kaptanlar";
    var y = Model.Yetki;
}

<h4>Kaptanlar</h4>
<a href="/Admin" class="btn btn-secondary btn-sm mb-3">← Panele Dön</a>

@if (y?.Ekle == true)
{
    <button class="btn btn-success btn-sm mb-3" data-bs-toggle="modal" data-bs-target="#ekleModal">+ Ekle</button>
}

<table id="tblKaptanlar" class="table table-striped table-bordered">
    <thead>
        <tr><th>ID</th><th>Ad</th><th>Soyad</th><th>E-posta</th><th>Maaş</th><th>İşe Giriş</th><th>İşlemler</th></tr>
    </thead>
    <tbody>
    @foreach (var k in Model.Kaptanlar)
    {
        <tr>
            <td>@k.Id</td>
            <td>@k.Ad</td>
            <td>@k.Soyad</td>
            <td>@(k.Email ?? "—")</td>
            <td>@(k.Maas.HasValue ? k.Maas.Value.ToString("N0") + " ₺" : "—")</td>
            <td>@(k.IseGirisTarihi?.ToString("dd.MM.yyyy") ?? "—")</td>
            <td>
                @if (y?.Degistir == true)
                {
                    <button class="btn btn-warning btn-sm"
                            onclick="guncelleAc(@k.Id,'@Html.Raw(k.Ad)','@Html.Raw(k.Soyad)',
                            '@Html.Raw(k.Email??"")',@(k.Maas?.ToString("F2",System.Globalization.CultureInfo.InvariantCulture)??"0"),
                            '@(k.IseGirisTarihi?.ToString("yyyy-MM-dd")??"")' )">
                        Düzenle
                    </button>
                }
                @if (y?.Sil == true)
                {
                    <form method="post" asp-page-handler="Sil" style="display:inline"
                          onsubmit="return confirm('@k.Ad @k.Soyad silinsin mi?')">
                        <input type="hidden" name="personelId" value="@k.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (y?.Ekle == true)
{
    <div class="modal fade" id="ekleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Kaptan Ekle</h5></div>
                <form method="post" asp-page-handler="Ekle">
                    <div class="modal-body">
                        <input name="ad" class="form-control mb-2" placeholder="Ad" required />
                        <input name="soyad" class="form-control mb-2" placeholder="Soyad" required />
                        <input name="email" type="email" class="form-control mb-2" placeholder="E-posta" />
                        <input name="maas" type="number" step="0.01" class="form-control mb-2" placeholder="Maaş" min="0" />
                        <input name="iseGirisTarihi" type="date" class="form-control mb-2"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-success">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (y?.Degistir == true)
{
    <div class="modal fade" id="guncelleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Kaptan Düzenle</h5></div>
                <form method="post" asp-page-handler="Guncelle">
                    <div class="modal-body">
                        <input type="hidden" name="personelId" id="gId" />
                        <input name="ad" id="gAd" class="form-control mb-2" placeholder="Ad" required />
                        <input name="soyad" id="gSoyad" class="form-control mb-2" placeholder="Soyad" required />
                        <input name="email" id="gEmail" type="email" class="form-control mb-2" placeholder="E-posta" />
                        <input name="maas" id="gMaas" type="number" step="0.01" class="form-control mb-2" placeholder="Maaş" min="0" />
                        <input name="iseGirisTarihi" id="gTarih" type="date" class="form-control mb-2" required />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-warning">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(function () {
        $('#tblKaptanlar').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json' } });
    });
    function guncelleAc(id, ad, soyad, email, maas, tarih) {
        document.getElementById('gId').value = id;
        document.getElementById('gAd').value = ad;
        document.getElementById('gSoyad').value = soyad;
        document.getElementById('gEmail').value = email;
        document.getElementById('gMaas').value = maas;
        document.getElementById('gTarih').value = tarih;
        new bootstrap.Modal(document.getElementById('guncelleModal')).show();
    }
</script>
}
