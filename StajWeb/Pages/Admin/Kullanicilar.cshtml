@page
@model StajWeb.Pages.Admin.KullanicilarModel
@using StajWeb.Helpers
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    var y = Model.Yetki;
    var benimId = HttpContext.Session.GetOturum()?.KullaniciId;
}

<h4>Kullanıcı Yönetimi</h4>
<a href="/Admin" class="btn btn-secondary btn-sm mb-3">← Panele Dön</a>

@if (y?.Ekle == true)
{
    <button class="btn btn-success btn-sm mb-3" data-bs-toggle="modal" data-bs-target="#ekleModal">+ Ekle</button>
}

<table id="tblKullanicilar" class="table table-striped table-bordered">
    <thead>
        <tr><th>ID</th><th>Kullanıcı Adı</th><th>Ad Soyad</th><th>Aktif</th><th>Oluşturma</th><th>İşlemler</th></tr>
    </thead>
    <tbody>
    @foreach (var k in Model.Kullanicilar)
    {
        <tr>
            <td>@k.KullaniciId</td>
            <td>@k.KullaniciAdi</td>
            <td>@(k.AdSoyad ?? "—")</td>
            <td>@(k.Aktif ? "✓" : "✗")</td>
            <td>@k.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
            <td>
                @if (y?.Degistir == true)
                {
                    <button class="btn btn-warning btn-sm"
                            onclick="guncelleAc(@k.KullaniciId,'@Html.Raw(k.KullaniciAdi)',
                            '@Html.Raw(k.AdSoyad??"")',@(k.Aktif ? "true" : "false"))">
                        Düzenle
                    </button>
                }
                @if (y?.Sil == true && k.KullaniciId != benimId)
                {
                    <form method="post" asp-page-handler="Sil" style="display:inline"
                          onsubmit="return confirm('@k.KullaniciAdi silinsin mi?')">
                        <input type="hidden" name="kullaniciId" value="@k.KullaniciId" />
                        <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (y?.Ekle == true)
{
    <div class="modal fade" id="ekleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Kullanıcı Ekle</h5></div>
                <form method="post" asp-page-handler="Ekle">
                    <div class="modal-body">
                        <input name="kullaniciAdi" class="form-control mb-2" placeholder="Kullanıcı Adı" required />
                        <input name="sifre" type="password" class="form-control mb-2" placeholder="Şifre" required />
                        <input name="adSoyad" class="form-control mb-2" placeholder="Ad Soyad" />
                        <div class="form-check">
                            <input name="aktif" type="checkbox" class="form-check-input" id="ekleAktif" checked value="true" />
                            <label class="form-check-label" for="ekleAktif">Aktif</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-success">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (y?.Degistir == true)
{
    <div class="modal fade" id="guncelleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Kullanıcı Düzenle</h5></div>
                <form method="post" asp-page-handler="Guncelle">
                    <div class="modal-body">
                        <input type="hidden" name="kullaniciId" id="gId" />
                        <input name="kullaniciAdi" id="gKullaniciAdi" class="form-control mb-2" placeholder="Kullanıcı Adı" required />
                        <input name="yeniSifre" type="password" class="form-control mb-2" placeholder="Yeni Şifre (boş bırakılırsa değişmez)" />
                        <input name="adSoyad" id="gAdSoyad" class="form-control mb-2" placeholder="Ad Soyad" />
                        <div class="form-check">
                            <input name="aktif" type="checkbox" class="form-check-input" id="gAktif" value="true" />
                            <label class="form-check-label" for="gAktif">Aktif</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-warning">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(function () { $('#tblKullanicilar').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json' } }); });
    function guncelleAc(id, kullaniciAdi, adSoyad, aktif) {
        document.getElementById('gId').value = id;
        document.getElementById('gKullaniciAdi').value = kullaniciAdi;
        document.getElementById('gAdSoyad').value = adSoyad;
        document.getElementById('gAktif').checked = aktif;
        new bootstrap.Modal(document.getElementById('guncelleModal')).show();
    }
</script>
}
