@page
@model StajWeb.Pages.SatinAlModel
@{
    ViewData["Title"] = "Satın Al";
}

<h4 class="mb-4">Yolcu Bilgileri</h4>
<p class="text-muted">Seçilen Koltuklar: <strong>@string.Join(", ", Model.KoltukList)</strong></p>

<form method="post">
    <input type="hidden" asp-for="SeferId" />
    <input type="hidden" asp-for="Koltuklar" />
    <input type="hidden" asp-for="Binis" />
    <input type="hidden" asp-for="Inis" />

    @for (int i = 0; i < Model.KoltukList.Count; i++)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header fw-bold">Koltuk @Model.KoltukList[i]</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <input name="Yolcular[@i].MusteriTc" class="form-control" placeholder="TC Kimlik No" maxlength="11" required />
                    </div>
                    <div class="col-md-6">
                        <select name="Yolcular[@i].MusteriCinsiyet" class="form-select" required>
                            <option value="">Cinsiyet Seçin</option>
                            <option value="E">Erkek</option>
                            <option value="K">Kadın</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <input name="Yolcular[@i].MusteriAd" class="form-control" placeholder="Ad" required />
                    </div>
                    <div class="col-md-6">
                        <input name="Yolcular[@i].MusteriSoyad" class="form-control" placeholder="Soyad" required />
                    </div>
                    <div class="col-md-6">
                        <input name="Yolcular[@i].MusteriMail" class="form-control" placeholder="E-posta" type="email" required />
                    </div>
                    <div class="col-md-6">
                        <input name="Yolcular[@i].MusteriTelefon" class="form-control" placeholder="Telefon (0 ile başlamalı)" maxlength="11" required />
                    </div>
                    <div class="col-md-6">
                        <input name="Yolcular[@i].MusteriSehir" class="form-control" placeholder="Şehir" required />
                    </div>
                    <div class="col-12">
                        <input name="Yolcular[@i].MusteriAdres" class="form-control" placeholder="Adres" required />
                    </div>
                </div>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary px-4">Satın Al</button>
</form>
