@page
@model StajWeb.Pages.SatinAlModel
@{
    ViewData["Title"] = "Satın Al";
}

<h2>Bilet Satın Al</h2>
<p>Seçilen Koltuklar: @string.Join(", ", Model.KoltukList)</p>

<form method="post">
    <input type="hidden" asp-for="SeferId" />
    <input type="hidden" asp-for="Koltuklar" />

    @for (int i = 0; i < Model.KoltukList.Count; i++)
    {
        <fieldset style="border:1px solid #ccc; padding:12px; margin-bottom:16px; border-radius:6px;">
            <legend>Koltuk @Model.KoltukList[i]</legend>

            <input name="Yolcular[@i].MusteriTc" placeholder="TC Kimlik No" maxlength="11" required /><br />
            <input name="Yolcular[@i].MusteriAd" placeholder="Ad" required /><br />
            <input name="Yolcular[@i].MusteriSoyad" placeholder="Soyad" required /><br />
            <input name="Yolcular[@i].MusteriMail" placeholder="E-posta" type="email" required /><br />
            <input name="Yolcular[@i].MusteriTelefon" placeholder="Telefon (0 ile başlamalı)" maxlength="11" required /><br />
            <input name="Yolcular[@i].MusteriSehir" placeholder="Şehir" required /><br />
            <input name="Yolcular[@i].MusteriAdres" placeholder="Adres" required /><br />
            <select name="Yolcular[@i].MusteriCinsiyet" required>
                <option value="">Cinsiyet Seçin</option>
                <option value="E">Erkek</option>
                <option value="K">Kadın</option>
            </select>
        </fieldset>
    }

    <button type="submit">Satın Al</button>
</form>
