@page
@model StajWeb.Pages.BiletSorgulaModel
@{
    ViewData["Title"] = "Bilet Sorgula";
}

<h2>Bilet Sorgula</h2>

<form method="post">
    <input asp-for="MusteriTc" placeholder="TC Kimlik No" />
    <button type="submit">Sorgula</button>
</form>

@if (Model.Biletler.Any())
{
    <table class="table mt-3">
        <thead>
            <tr>
                <th>Bilet No</th>
                <th>Firma</th>
                <th>Kalkış</th>
                <th>Varış</th>
                <th>Tarih</th>
                <th>Koltuk</th>
                <th>Fiyat</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Biletler)
            {
                <tr>
                    <td>@b.BiletId</td>
                    <td>@b.FirmaAdi</td>
                    <td>@b.KalkisSehirAdi</td>
                    <td>@b.VarisSehirAdi</td>
                    <td>@b.KalkisZamani.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@b.KoltukNo</td>
                    <td>@b.Fiyat ₺</td>
                    <td><a href="/BiletIptal?biletId=@b.BiletId" class="btn btn-danger btn-sm">İptal</a></td>
                </tr>
            }
        </tbody>
    </table>
}
